#find the duplicate elements in a list
numbers = [4, 7, 2, 7, 4, 9, 2, 5]

seen = set()
duplicates = []

for num in numbers:
    if num in seen:
        if num not in duplicates:
            duplicates.append(num)
    else:
        seen.add(num)

print("Duplicate elements:", duplicates)